# Docker 部署配置（复制为 .env）

# 镜像定位。默认 artex:custom = 本地构建产物，由 ./build-image.sh 生成
# （基础镜像取自我们自己的公开镜像 ghcr.io/darkkid0/artex:base，无需登录）。
ARTEX_IMAGE=artex
ARTEX_TAG=custom

# 想直接拉预构建镜像，改成下面这行即可（对应 tag 见 DEPLOY-custom.md）：
# ARTEX_IMAGE=ghcr.io/darkkid0/artex
# ARTEX_TAG=base        # 仅运行时工具链，需自行替换 /app/artex 二进制
# ARTEX_PULL_POLICY=missing   # 默认值；本地有就用本地，没有才拉

# PostgreSQL 镜像。默认走 Docker Hub 的 postgres:16-alpine；取消下面注释即改用
# 我们自己的镜像，彻底脱离 Docker Hub（digest 锁定，内容与官方同一镜像，11 层
# 逐字节一致，实测 PostgreSQL 16.15 正常运行）。
# POSTGRES_IMAGE=ghcr.io/darkkid0/artex:postgres-16-alpine@sha256:1a66d744c1b459e13b05a8fca341da84cb63383e99ce262210efee5a319d4551

POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
