# Docker 部署配置（复制为 .env）

# 镜像定位。默认 artex:custom = 本地构建产物，由 ./build-image.sh 生成
# （基础镜像取自我们自己的公开镜像 ghcr.io/darkkid0/artex:base，无需登录）。
ARTEX_IMAGE=artex
ARTEX_TAG=custom

# 想直接拉预构建镜像，改成下面这行即可（对应 tag 见 DEPLOY-custom.md）：
# ARTEX_IMAGE=ghcr.io/darkkid0/artex
# ARTEX_TAG=base        # 仅运行时工具链，需自行替换 /app/artex 二进制
# ARTEX_PULL_POLICY=missing   # 默认值；本地有就用本地，没有才拉

POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
